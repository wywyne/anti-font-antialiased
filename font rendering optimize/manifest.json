{
  "manifest_version": 3,
  "name": "Auto Font Smoothing",
  "version": "1.1",
  "description": "强制使用 -webkit-font-smoothing: auto，覆盖 antialiased，支持 Shadow DOM。",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "css": ["inject.css"]
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["shadow-dom-patch.js"],
      "world": "MAIN"
    }
  ]
}
